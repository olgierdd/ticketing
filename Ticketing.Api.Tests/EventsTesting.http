@baseUrl = http://localhost:8080

@jazzEventId = 5b5e242b-7ffb-4537-b544-2e1601692a38
@nordicEventId = 8b3c467f-0281-4df1-93ea-6ff422e016ab
@symphonicEventId = 740758a8-168e-4938-bc86-ee45359597af

@jazzVIPPriceTierId = 7a06e345-3a11-42b7-a90d-dc82c3220c70
@jazzBookingId = BK-20260901-0333C12316

@nordicLightsPriceStandardId = 4062bd6e-fa7f-47e8-89ee-bc479ab1bb03
@nordicBookingRef = BK-20260901-C48AA387CA

@symphonicPriceStandard = c4b62cf9-898c-4bb5-9271-81702a54da40
@symphonicBookingRef = BK-20260901-0BC17E8134

### All Events
GET {{baseUrl}}/api/v1/events?pageNumber=1&pageSize=20
Accept: application/json

### Jazz Under Stars - availability
GET {{baseUrl}}/api/v1/tickets/availability/{{jazzEventId}}
Accept: application/json

### Jazz Under Stars - event details (copy a pricingTierId from the response)
GET {{baseUrl}}/api/v1/events/{{jazzEventId}}
Accept: application/json

### Jazz Under Stars - purchase tickets
POST {{baseUrl}}/api/v1/tickets/purchases
Content-Type: application/json
Accept: application/json

{
  "eventId": "{{jazzEventId}}",
  "pricingTierId": "{{jazzVIPPriceTierId}}",
  "customerName": "Alice",
  "customerEmail": "alice@example.com",
  "quantity": 2
}

### Jazz Under Stars - booking details by booking reference
GET {{baseUrl}}/api/v1/tickets/purchases/reference/{{jazzBookingId }}
Accept: application/json

### Jazz Under Stars - sales summary
GET {{baseUrl}}/api/v1/reports/events/{{jazzEventId}}/sales-summary
Accept: application/json

### Nordic Lights Live - availability
GET {{baseUrl}}/api/v1/tickets/availability/{{nordicEventId}}
Accept: application/json

### Nordic Lights Live - event details
GET {{baseUrl}}/api/v1/events/{{nordicEventId}}
Accept: application/json

### Nordic Lights Live - purchase tickets
POST {{baseUrl}}/api/v1/tickets/purchases
Content-Type: application/json
Accept: application/json

{
  "eventId": "{{nordicEventId}}",
  "pricingTierId": "{{nordicLightsPriceStandardId}}",
  "customerName": "Bob",
  "customerEmail": "bob@example.com",
  "quantity": 5
}

### Nordic Lights Live - booking details by booking reference
