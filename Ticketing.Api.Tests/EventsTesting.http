### Rock Chicago Live
POST {{baseUrl}}//api/v1/events
Content-Type: application/json
Accept: application/json

{
  "name": "Rock Chicago Live",
  "description": "Rock Chicago Live",
  "venue": "Main Hall",
  "eventDate": "2026-09-14",
  "startTime": "19:30:00",
  "totalTicketCapacity": 150,
  "pricingTiers": [
    {
      "name": "Premium",
      "price": 110.00,
      "capacity": 60
    },
    {
      "name": "Standard",
      "price": 40,
      "capacity": 100
    }
  ]
}
